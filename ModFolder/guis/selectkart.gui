windowDef Desktop {
    rect 0, 0, 640, 480
    backcolor 0, 0, 0, 1

    windowDef Title {
        rect        0, 100, 640, 40
        text        "PICK A KART"
        textalign   1
        forecolor   1, 1, 1, 1
    }

    windowDef Kart0 {
        rect        220, 200, 200, 30
        text        "1 - TANK"
        textalign   1
        forecolor   1, 1, 1, 1
    }

    windowDef Kart1 {
        rect        220, 250, 200, 30
        text        "2 - TANK"
        textalign   1
        forecolor   1, 1, 1, 1
    }

    windowDef Kart2 {
        rect        220, 300, 200, 30
        text        "3 - WALKER"
        textalign   1
        forecolor   1, 1, 1, 1
    }
}