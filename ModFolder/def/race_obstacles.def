// ngc2 course obstacles

// boost pad, speed up X axis. 
entityDef boostpad {
        "spawnclass"    "idForceField"
        "uniform"       "-1500 0 0"
        "start_on"      "1"
}

// jump pad, speed up X slightly, laucnh on Y
entityDef jumppad {
        "spawnclass"    "idForceField"
        "uniform"       "-300 0 600"
        "start_on"      "1"
        "mins"          "-50 -50 -50"
        "maxs"          "50 50 50"
}

// spikes, hurts kart every half sec
entityDef spikes {
        "spawnclass"    "idTrigger_Hurt"
        "delay"         "0.5"
}

// saw blade, just spins (spikes trigger on it does the damage)
entityDef saw {
        "spawnclass"    "idRotater"
        "start_on"      "1"
}
entityDef sawhurt {
        "spawnclass"    "idTrigger_Hurt"
        "def_damage"    "damage_saw"
        "delay"         "0.5"
        "mins"          "-50 -50 -50"
        "maxs"          "50 50 50"
}

// saw damage amount
entityDef damage_saw {
        "damage"        "50"
}