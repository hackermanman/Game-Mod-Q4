// ngc2 kart item box, gives random kart item on pickup one to ten
entityDef itembox {
        "editor_color"                  ".3 .3 1"
        "editor_mins"                   "-16 -16 0"
        "editor_maxs"                   "16 16 32"
        "editor_menu"                   "pickup"

        "spawnclass"                    "idItem"
        "model"                                 "models/gibs/skull.lwo"
        "mtr_highlight"                 "models/weapons/itemHighlightShell"

        "item_kartBox"                  "1"
        "triggersize"                   "48"
        "spin"                                  "1"
        "nodrop"                                "1"
        "respawn"                               "5"

        "snd_acquire"                   "pickup_armor"
}